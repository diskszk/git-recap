{
  "outputStyle": "Learning",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "echo '{\"systemMessage\": \"push前にコードレビュー(/code-review)を実行しましたか？未実施なら先にレビューしてください。\"}'"
          }
        ]
      }
    ]
  }
}
